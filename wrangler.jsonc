{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "turbo-wpp",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-11-03",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "turbo-ranking",
    "database_id": "ac74b33c-df8c-4d72-8aee-f857f1363988",
    "migrations_dir": "migrations"
  }]
}
